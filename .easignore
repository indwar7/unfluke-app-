node_modules/

# Web-only landing/marketing images — not used by the React Native app.
# Kept on disk but untracked so they don't bloat the EAS build upload (~120MB).
assets/images/NewLandingImages/
assets/images/landing/
assets/images/photos/
assets/images/nft/
assets/images/galaxy/
assets/images/pattern/
assets/images/dashboard_img/
assets/images/STEP1.jpg
assets/images/STEP2.jpg
assets/images/STEP3.jpg
assets/images/g10.png
assets/images/job-profile2.png

# android/ — tracked for EAS bare workflow builds
android/build/
android/app/build/
android/.gradle/
android/local.properties
ios/
.expo/
*.lock
# yarn.lock must be committed: EAS builds from git, and without it yarn
# re-resolves every ^/~ range on the build server. That makes builds
# non-reproducible and lets a transitive dependency change silently between
# releases — a real source of "worked locally, crashed in production".
!yarn.lock
.gradle/
build/
dist/
.DS_Store
.idea/
.vscode/
*.log
*.tsbuildinfo

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli
.codegraphy/
node_modules/

# Android signing keys — NEVER commit
*.jks
*.keystore
!android/app/debug.keystore

# Build artifacts — large binaries, don't belong in git
*.aab
*.ipa

# Credentials / cert config exported from EAS — NEVER commit (contains cert serials, Team ID, API key refs)
ios data.txt

# Single lockfile: this project uses yarn (see packageManager in package.json).
package-lock.json

# ── .easignore additions ─────────────────────────────────────────────
# EAS uses THIS file instead of .gitignore when it exists, so everything
# above is copied from .gitignore and must stay in sync with it.
#
# Below: files that belong in git but are dead weight in a build archive.
# The upload failed at 83/168 MB with EPIPE; trimming it reduces both the
# upload time and the chance of another mid-transfer drop.

# Store listing screenshots — never referenced by the app bundle
appstore-assets/
playstore-assets/
screenshots/

# Build outputs and local scratch
*.aab
*.apk
*.ipa
.archive/
docs/
preview/

# Local error dumps from typecheck runs
ts_errors.txt
tsc_errors.txt
final_errors.txt

# Credentials — must never reach a build server
credentials/
*.jks
*.keystore
*.p12
*.mobileprovision

# Gradle evaluates signingConfigs.debug { storeFile file("debug.keystore") } at
# configuration time even for release builds, so this file must be present or
# the build fails before it starts. Re-allow it after the *.keystore rule above.
!android/app/debug.keystore
