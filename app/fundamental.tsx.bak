useEffect(() => {
  if (headerData?.results) {
    const results = headerData?.results;
    console.log("Financial data results:", results);
    
    const sortedKeys = Object.keys(results).sort();
    
    if (sortedKeys.length > 0) {
      const lastKey = sortedKeys[sortedKeys.length - 1];
      const financialData = results[lastKey];
      setFinancialData(financialData);
    }
  }
}, [headerData]);


