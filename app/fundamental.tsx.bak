  useEffect(() => {
    const fetchCompanyName = async () => {
      setIsLoading(true);
      try {
        const response = await getCompanyName({
          params: { instrument: company },
        });

        if (response) {
          setCompanyName(response?.name);
        }

        const stockSymbol = await getStockSymbol({ capitaline_code: company });

        if (stockSymbol) {
          setStockSymbol(stockSymbol?.symbol);
        }
      } catch (error) {
        console.error("Error fetching company name:", error);
      } finally {
        setIsLoading(false);
      }
    };

    company && fetchCompanyName();
  }, [company]);

  useEffect(() => {
    async function fetchData() {
      console.log("Loading Daily Ratios Data-->", company);
      setIsDailyRatiosLoading(true);
      try {
        const result = await getDailyRatiosData({
          params: {
            instrument: company,
            mode: "S",
          },
        });

        // console.log("Daily ratios data:", result);
        setDailyRatiosData(result || null);
      } catch (error) {
        console.error("Error fetching data:", error);
        setDailyRatiosData(null);
      } finally {
        setIsDailyRatiosLoading(false);
      }
    }

    company && fetchData();
  }, [company]);

  
  useEffect(() => {
    async function checkBankRatioData() {
      try {
        const result = await getBankingData({
          type: isConsolidated ? "C" : "S",
          capcode: company,
        });

        const hasData = result && Object.keys(result.results || {}).length > 0;
        setIsBankRatioAvailable(hasData);
      } catch (error) {
        setIsBankRatioAvailable(false);
      } finally {
        setBankRatioChecked(true);
      }
    }
    if (company) {
      setBankRatioChecked(false);
      checkBankRatioData();
    }
  }, [company, isConsolidated]);

  const tabs = [
