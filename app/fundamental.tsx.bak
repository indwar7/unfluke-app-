            )}
            {companyName && company && activeTab === "quarterly" && (
              <QuaterlyResultsTable isConsolidated={isConsolidated} company={company} />
            )}
            {companyName && company && activeTab === "deals" && (
              <BulkAndBlockDealsTable isConsolidated={isConsolidated} company={company} />
            )}
            {companyName && company && activeTab === "events" && (
              <CorporateEventsTable isConsolidated={isConsolidated} company={company}/>
            )}
               {companyName && company && activeTab === "shareholding" && (
              <ShareholdingPatternsChart company={company}/>
            )}
            {companyName &&
              company &&
              activeTab === "bankratio" &&
              isBankRatioAvailable && (
                <BankRatio
                  isConsolidated={isConsolidated}
                  company={company}
                  onDataCheck={(available) =>
                    setIsBankRatioAvailable(available)
                  }
                />
              )}
          </View>
        </View>
      </ScrollView>
    </View>
  );
};

